import java.util.*;
public class Main 
{
    public static void stock(int[] a)
    {
       int  result = a[0];
        for(int i=0;i<a.length;i++)
        {
            for(int j=i+1;j<a.length;j++)
            {
                result = Math.max(result,a[j]-a[i]);
            }
    
        }
        System.out.println(result);
    }
    public static void main(String[] args)
    {
        int[] a ={11, 300, 6, 9, 11};
        stock(a);
    }
}
