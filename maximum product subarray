import java.lang.Math;
public class Main 
{
    public static void maxsum(int [] a)
    {
        int result =a[0];
        for(int i=0; i<a.length;i++)
        {
            int multi=1;
            for(int j=i;j<a.length;j++)
            {
                multi*=a[j];
                result=Math.max(result,multi);
                
            }
            
        }
        System.out.println(result);
    }
    public static void main(String[] args)
    {
        int[] a= { -2, 6, -3, -10, 0, 2 };
       
        maxsum(a);
    }
}
